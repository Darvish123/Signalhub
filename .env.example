APP_ENV=development
DATABASE_PATH=./data/signalhub.db
BITUNIX_FUTURES_BASE_URL=https://fapi.bitunix.com
BITUNIX_SPOT_BASE_URL=https://www.bitunix.com
REQUEST_TIMEOUT_SECONDS=12
